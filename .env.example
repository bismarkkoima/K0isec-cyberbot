# Copy this file to .env and adjust if needed.
# K0isec Guardian runs fully offline - no cloud API keys are required.

# Address of the local Ollama server (https://ollama.com)
OLLAMA_HOST=http://localhost:11434

# Local model to use. Small models work well on ordinary laptops:
#   llama3.2:3b  (default, ~2 GB)   phi3:mini   gemma2:2b   qwen2.5:3b
OLLAMA_MODEL=llama3.2:3b

# Seconds to wait for the model before falling back to the built-in guide
OLLAMA_TIMEOUT=60

# Set to 1 only while developing
FLASK_DEBUG=0
